    <string name="help_chat_account_title">Your messaging account</string>
    <string name="help_chat_account_body">Create an account or sign in from account settings. Your address includes your messaging server; a short @username is scoped to that server. Keep your password private.</string>
    <string name="help_chat_contacts_title">Add a contact</string>
    <string name="help_chat_contacts_body">Use a messaging address, a contact link or a QR code. Review the proposed contact before saving. Profile publication is optional and requires your consent.</string>
    <string name="help_chat_privacy_title">Verify your devices</string>
    <string name="help_chat_privacy_body">Private messages and groups require end-to-end encryption and trusted devices. Compare fingerprints with your contact before approving a device. A public profile is readable by the server.</string>
    <string name="help_chat_delivery_title">Connection and delivery</string>
    <string name="help_chat_delivery_body">Check the connection and message status before retrying. Background connection is optional and uses a visible notification. Android may suspend delivery; force-stopping the app stops it until you reopen it.</string>
